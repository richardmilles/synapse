# URL Supabase Transaction pooler, port 6543, compatible Vercel Functions
POSTGRES_URL=postgresql://user:password@host/database?sslmode=require

# URL publique utilisée dans les liens de confirmation et désinscription
PUBLIC_SITE_URL=https://www.synapse-lab.co

# Optionnel tant que la collecte sert uniquement à constituer la base
# À renseigner plus tard pour Brevo, MailerLite, Kit, n8n ou Make
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_SECRET=

# Protège l'export CSV via Authorization: Bearer <secret>
EXPORT_SECRET=
